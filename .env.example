# Point to LiteLLM proxy (run `litellm --config litellm_config.yaml --port 4000` first)
ANTHROPIC_BASE_URL=http://localhost:4000

# Required by SDK but ignored by LiteLLM (real key goes in litellm_config.yaml)
ANTHROPIC_API_KEY=sk-placeholder

# Ollama embedding settings (optional; defaults shown)
EMBEDDING_MODEL=nomic-embed-text-v2-moe
OLLAMA_EMBEDDING_URL=http://localhost:11434/api/embeddings
EMBEDDING_CACHE_SIZE=256
